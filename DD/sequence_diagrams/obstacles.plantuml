@startuml
skinparam style strictuml
skinparam sequenceMessageAlign center
skinparam maxMessageSize 350
skinparam ParticipantPadding 15
skinparam BoxPadding 10

actor "Registered\nUser" as user
participant "App" as app <<Mobile>>
participant "Device" as dev <<Hardware>>
box "BBP Server Logic" #F5F5F5
    participant "Dashboard\nManager" as dashMan
    participant "Recording\nManager" as recMan
    participant "External\nInterface" as extInt
    participant "Query\nManager" as queryMan
end box
participant "External\nAPIs" as extApi <<System>>
database "DBMS" as db <<Database>>

activate user
user -> app : startAutomatedMode()
activate app

app -> dashMan : startSessionRequest()
activate dashMan
dashMan -> recMan : initSession()
activate recMan
recMan --> dashMan : sessionID
deactivate recMan
dashMan --> app : ack
deactivate dashMan

app -> app : showBanner("Recording Started")

' --- LOOP 1: RECORDING & DETECTION ---
loop every 1 second (Active Recording)
    app -> dev : getSensorData(Position, Accel, Gyro)
    activate dev
    dev --> app : metrics
    deactivate dev

    app -> dashMan : sendTelemetry(sessionID, metrics)
    activate dashMan
    dashMan -> recMan : processTelemetry(metrics)
    activate recMan

    opt from 2nd iteration onwards
        recMan -> recMan : createSegment(prevNode, currNode)
        
        ' Distance Calculation
        recMan -> extInt : calculateDistance(nodeA, nodeB)
        activate extInt
        extInt -> extApi : fetchDistance(coordsA, coordsB)
        activate extApi
        
        alt API Call Successful
            extApi --> extInt : distanceValue
            extInt --> recMan : distanceValue
            recMan -> recMan : updateTripMetrics(distance)
        else External API Error
            extApi --> extInt : error
            deactivate extApi
            extInt --> recMan : null
            deactivate extInt
            note right of recMan : Segment distance skipped,\nprocessing continues
        end

        ' Obstacle Detection Logic
        recMan -> recMan : analyzeMotionForObstacles(accel, gyro)
        alt Significant bump/shock detected
            recMan -> recMan : flagSegmentAsObstacle(segmentID)
        end
    end
    recMan --> dashMan : ack
    deactivate recMan
    dashMan --> app : ack
    deactivate dashMan
end

' --- STOP & VERIFICATION ---
user -> app : stopRecording()

app -> dashMan : stopSessionRequest(sessionID)
activate dashMan
dashMan -> recMan : prepareVerificationData()
activate recMan
recMan --> dashMan : list(potentialObstacles)
deactivate recMan
dashMan --> app : return(potentialObstacles)
deactivate dashMan

' --- LOOP 2: USER VERIFICATION ---
loop for each detected obstacle
    app -> user : displayVerificationForm(mapLocation)
    user -> app : confirmObstacle(Yes/No)
    
    app -> dashMan : submitFeedback(segmentID, isConfirmed)
    activate dashMan
    dashMan -> recMan : updateObstacleData(segmentID, isConfirmed)
    activate recMan
    
    alt User Confirmed (Yes)
        recMan -> recMan : markConfirmedObstacle()
    else User Rejected (No)
        recMan -> recMan : discardObstacleFlag()
    end
    recMan --> dashMan : ack
    deactivate recMan
    dashMan --> app : ack
    deactivate dashMan
end

' --- FINALIZATION ---
app -> dashMan : finalizeTripRequest(sessionID)
activate dashMan
dashMan -> recMan : finalizeTrip()
activate recMan

recMan -> recMan : calculateFinalMetrics()

' Storage
recMan -> queryMan : saveCompleteTrip(tripObject)
activate queryMan
queryMan -> db : INSERT INTO Trips ...
activate db
db --> queryMan : success
deactivate db
queryMan --> recMan : tripID
deactivate queryMan

recMan --> dashMan : tripSummary
deactivate recMan

dashMan --> app : showTripSummary(metrics)
deactivate dashMan

app --> user : displaySummaryPage()
deactivate app
deactivate user

@enduml