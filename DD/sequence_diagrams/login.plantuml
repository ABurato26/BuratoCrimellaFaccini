@startuml
skinparam style strictuml
skinparam sequenceMessageAlign center
skinparam maxMessageSize 350
skinparam ParticipantPadding 25
skinparam BoxPadding 10

actor "User" as user
participant "App" as app <<Mobile>>
box "BBP Server Logic" #F5F5F5
    participant "Dashboard\nManager" as dashMan
    participant "Authentication\nManager" as authMan
    participant "Query\nManager" as queryMan
    participant "Notification\nManager" as notifMan
end box
database "DBMS" as db <<Database>>

activate user
user -> app : inputCredentials(email, password)
activate app

app -> app : validateFormat(email)
note right: Local validation before\nnetwork request

alt invalid format
    app --> user : showFormatError()
else valid format
    ' Include deviceID for notification registration
    app -> dashMan : loginRequest(email, password, deviceID)
    activate dashMan

    dashMan -> authMan : authenticateUser(email, password)
    activate authMan

    ' AUTH -> QUERY MANAGER (Abstraction Layer)
    authMan -> queryMan : fetchUserByEmail(email)
    activate queryMan
    
    queryMan -> db : SELECT * FROM Users WHERE email = ?
    activate db
    db --> queryMan : ResultSet (UserRow)
    deactivate db
    
    queryMan --> authMan : UserEntity (hash, salt, status) OR null
    deactivate queryMan

    alt user not found
        authMan --> dashMan : throw UserNotFoundException
        dashMan --> app : sendError(404, "Account not found")
        app --> user : displayError("User not registered")
    
    else user found
        authMan -> authMan : verifyPassword(password, storedHash, salt)
        
        alt password mismatch
            authMan --> dashMan : throw InvalidCredentialsException
            dashMan --> app : sendError(401, "Invalid password")
            app --> user : displayError("Wrong credentials")
        
        else password matches
            ' Token Generation
            authMan -> authMan : generateSessionToken(userID)
            
            ' Update Login Timestamp via QueryManager
            authMan -> queryMan : executeUpdateLastLogin(userID, timestamp)
            activate queryMan
            queryMan -> db : UPDATE Users SET last_login = ? ...
            activate db
            db --> queryMan : success
            deactivate db
            queryMan --> authMan : confirmUpdate
            deactivate queryMan
            
            authMan --> dashMan : return SessionToken, UserProfile
            deactivate authMan

            ' NOTIFICATION MANAGER INTEGRATION
            ' Register device for push notifications upon successful login
            dashMan -> notifMan : registerDeviceToken(userID, deviceID)
            activate notifMan
            notifMan -> queryMan : storeDeviceToken(userID, deviceID)
            activate queryMan
            queryMan -> db : INSERT/UPDATE DeviceTokens ...
            activate db
            db --> queryMan : success
            deactivate db
            queryMan --> notifMan : success
            deactivate queryMan
            notifMan --> dashMan : registrationConfirmed
            deactivate notifMan

            ' Final Response
            dashMan --> app : loginSuccess(SessionToken, UserProfile)
            deactivate dashMan

            app -> app : storeSession(SessionToken)
            app --> user : redirect(HomePage)
        end
    end
end
deactivate app
deactivate user
@enduml